# FastAPI 챗봇 서버
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8001

# Spring Boot와 챗봇 서버 간 내부 인증
# X-Chatbot-Token 헤더 검증. OS 환경변수 미설정·빈 값이면 내부 POST 503
# 실제 값은 로컬 OS 환경에만 설정하며 이 파일에는 기록하지 않음
CHATBOT_API_TOKEN=

# Ollama 서버 및 모델
# 현재 연결 모듈은 OS 환경변수를 사용하며 .env 파일은 자동 로딩하지 않음
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# RAG
# Elasticsearch 검색 미구현: 정상 인증 후 내부 POST는 503 RAG_NOT_READY
